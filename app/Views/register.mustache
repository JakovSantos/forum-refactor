{{> partials/header}}
<h1>Create an account</h1>

{{#has_errors}}
<div class="notice error" role="alert">
    <p>Please fix the following:</p>
    <ul>
        {{#errors}}
        <li>{{.}}</li>
        {{/errors}}
    </ul>
</div>
{{/has_errors}}

<form class="auth-form" method="post" action="{{base}}/register">
    <input type="hidden" name="_token" value="{{csrf_token}}">

    <label for="username">Username</label>
    <input id="username" name="username" type="text" value="{{old.username}}" minlength="3" maxlength="30" autocomplete="username" required>

    <label for="email">Email</label>
    <input id="email" name="email" type="email" value="{{old.email}}" maxlength="254" autocomplete="email" required>

    <label for="password">Password (8 to 72 characters)</label>
    <input id="password" name="password" type="password" minlength="8" maxlength="72" autocomplete="new-password" required>

    <label for="password_confirm">Confirm password</label>
    <input id="password_confirm" name="password_confirm" type="password" minlength="8" maxlength="72" autocomplete="new-password" required>

    <button type="submit">Register</button>
</form>
<p>Already have an account? <a href="{{base}}/login">Log in</a>.</p>
{{> partials/footer}}
